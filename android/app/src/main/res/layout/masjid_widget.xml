<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <!-- Header: icon + masjid name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@mipmap/ic_launcher"/>
        <TextView
            android:id="@+id/w_masjid_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="#F5E9C8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Masjid Timings"/>
    </LinearLayout>

    <TextView
        android:id="@+id/w_masjid_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#A0AAA8"
        android:textSize="10sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:text=""/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#33D4AF37"/>

    <!-- Next prayer big block -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#D4AF37"
        android:textSize="9sp"
        android:letterSpacing="0.15"
        android:textStyle="bold"
        android:text="NEXT PRAYER"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginTop="2dp">
        <TextView
            android:id="@+id/w_prayer_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFAEC"
            android:textSize="22sp"
            android:textStyle="bold"
            android:text="—"/>
        <TextView
            android:id="@+id/w_prayer_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:textColor="#E8C863"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="—"/>
    </LinearLayout>

    <TextView
        android:id="@+id/w_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#C5BFA8"
        android:textSize="11sp"
        android:text=""/>

    <!-- 5-prayer grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:padding="8dp"
        android:background="#33000000">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/w_p1_name" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="9sp"
                android:textStyle="bold" android:text="Fajr"/>
            <TextView android:id="@+id/w_p1_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="11sp"
                android:textStyle="bold" android:text="—"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/w_p2_name" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="9sp"
                android:textStyle="bold" android:text="Dhuhr"/>
            <TextView android:id="@+id/w_p2_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="11sp"
                android:textStyle="bold" android:text="—"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/w_p3_name" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="9sp"
                android:textStyle="bold" android:text="Asr"/>
            <TextView android:id="@+id/w_p3_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="11sp"
                android:textStyle="bold" android:text="—"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/w_p4_name" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="9sp"
                android:textStyle="bold" android:text="Mag"/>
            <TextView android:id="@+id/w_p4_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="11sp"
                android:textStyle="bold" android:text="—"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/w_p5_name" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="9sp"
                android:textStyle="bold" android:text="Isha"/>
            <TextView android:id="@+id/w_p5_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="11sp"
                android:textStyle="bold" android:text="—"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Admin overdue badge (visibility toggled in code) -->
    <TextView
        android:id="@+id/w_overdue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="6dp"
        android:textColor="#FCA5A5"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:background="#33DC2626"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone"
        android:text=""/>

    <TextView
        android:id="@+id/w_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#80A0AAA8"
        android:textSize="9sp"
        android:text=""/>
</LinearLayout>
